  "faq": {
    "catGroups": "🏢 गट व्यवस्थापन",
    "q1": "मी नवीन गट कसा तयार करू?",
    "a1": "होम स्क्रीनवर 'नवीन गट बनवा' वर क्लिक करा. गटाचे नाव आणि मासिक वर्गणी टाका. तुम्ही आपोआप गटप्रमुख (Admin) व्हाल.",
    "q2": "मी अस्तित्वात असलेल्या गटात कसा सामील होऊ?",
    "a2": "तुमच्या गटप्रमुखांना ६-अक्षरी Invite Code विचारा. 'गटात सामील व्हा' वर क्लिक करून तो कोड टाका. गटप्रमुखांनी मान्यता दिल्यावर तुम्ही गटात सामील व्हाल.",
    "catTx": "💰 व्यवहार आणि बचत",
    "q3": "माझी बचत कोण नोंदवू शकते?",
    "a3": "सुरक्षिततेसाठी, फक्त गटप्रमुख (Admin) अधिकृतपणे जमा, काढलेली रक्कम आणि कर्जाची परतफेड नोंदवू शकतात.",
    "q4": "चूक झाल्यास व्यवहार कसा बदलावा किंवा रद्द करावा?",
    "a4": "गटप्रमुख 'Group Details' मध्ये जाऊन 'अलीकडील व्यवहार' खाली पेन्सिल आयकॉन वापरून बदल करू शकतात, किंवा कचराकुंडी आयकॉन वापरून व्यवहार रद्द (Void) करू शकतात. पारदर्शकतेसाठी रद्द केलेले व्यवहार यादीत दिसतात.",
    "catReports": "📄 पावत्या आणि अहवाल",
    "q5": "मी WhatsApp वर पावती कशी पाठवू?",
    "a5": "गटातील 'अलीकडील व्यवहार' मध्ये जाऊन कोणत्याही व्यवहाराखालील हिरव्या 'Send Receipt' बटणावर क्लिक करा. पावती थेट WhatsApp वर पाठवली जाईल.",
    "q6": "मी माझे पासबुक/अहवाल कसा डाउनलोड करू?",
    "a6": "'My Profile' मध्ये जाऊन 'Download Complete Statement' वर क्लिक करा. गटप्रमुख 'Passbook' स्क्रीनवरून संपूर्ण गटाचा अहवाल डाउनलोड करू शकतात.",
    "catSecurity": "🔒 सुरक्षा आणि कर्ज",
    "q7": "माझी आर्थिक माहिती सुरक्षित आहे का?",
    "a7": "होय! तुमचा डेटा क्लाउडवर सुरक्षित आहे. तुम्ही फोन गमावला किंवा इंटरनेट नसले तरीही तुमचा रेकॉर्ड सुरक्षित राहतो.",
    "q8": "मी कर्जासाठी अर्ज कसा करू?",
    "a8": "गटातील 'Manage Loans' मध्ये जा. रक्कम, कालावधी आणि प्रस्तावित व्याजदर टाका आणि गटप्रमुखांच्या मान्यतेसाठी विनंती पाठवा."
